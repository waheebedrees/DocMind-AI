JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MAX_UPLOAD_MB=50



# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=/var/lib/docmind/storage


DEBUG=false
VERSION=0.1.0
APP_ENv=development
APP_NAME=DocMind AI
API_V1_PREFIX= /api/v1
ALLOW_CREDENTIALS=true
API_KEY_HEADERS=X-API-KEY

POSTGRES_HOST=postgres 
POSTGRES_PORT=5432
POSTGRES_USER=docmind
POSTGRES_PASSWORD=docmind
POSTGRES_DB=docmind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO = false

REDIS_HOST= redis
REDIS_PORT = 6379
REDIS_PASSWORD=REDIS_PASSWORD


